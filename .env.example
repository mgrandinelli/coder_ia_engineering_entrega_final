# Plantilla de variables de entorno: copiar como .env y completar la clave. El .env no se sube al repo.
# Con Docker Compose, las direcciones de Redis, ChromaDB y Phoenix las fija docker-compose.yml.

# Modelo de lenguaje: openai o anthropic. Sin clave, el sistema corre en modo demostración.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# Embeddings: openai (text-embedding-3-small) o local (sin clave). Vacío: openai si hay OPENAI_API_KEY.
EMBEDDINGS_PROVIDER=

# Servicios (valores para correr la API fuera de Docker)
REDIS_URL=redis://localhost:6380
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=atlas_docs
TOP_K=5

# Observabilidad con Arize Phoenix
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=atlas-intelligence

# Puerto de la API en la máquina local
API_PORT=8000

# Trabajos que se ejecutan a la vez
WORKER_CONCURRENCY=5
